<% content_for :title, t("search.title") %>
<div class="container">
  <h1><%= t("search.advanced") %></h1>
  <%= form_with url: search_path, method: :get, local: true, data: { controller: "loading-form" } do |form| %>
    <div role="search" class="search-row">
      <%= form.search_field :q, value: params[:q], placeholder: t("search.placeholder") %>
      <%= form.submit t("helpers.submit.search"), name: "search", data: { "loading-form-target": "button", "loading-text": t("search.loading") } %>
    </div>
    <%= render "shared/loading_overlay", text: t("search.loading") %>
    <%= render "carried_filters" %>
    <details class="filters" <%= "open" if search_filters_open? %>>
      <summary><%= t("search.filters") %></summary>
      <div class="grid-auto">
        <div>
          <%= form.label :job_name, DiseaseCase.human_attribute_name(:job_name) %>
          <%= form.text_field :job_name, value: params[:job_name] %>
        </div>
        <div>
          <%= form.label :job_description, DiseaseCase.human_attribute_name(:job_description) %>
          <%= form.text_field :job_description, value: params[:job_description] %>
        </div>
      </div>
      <fieldset data-controller="checkbox-group">
        <legend>
          <%= t("search.search_in_columns") %>
          <%= link_to t("search.select_all") , "#", data: { action: "click->checkbox-group#selectAll" } %>
          <%= link_to t("search.deselect_all") , "#", data: { action: "click->checkbox-group#deselectAll" } %>
        </legend>
        <div class="checkbox-grid">
          <% DiseaseCases::Searchable::SEARCHABLE_COLUMNS.each do |column| %>
            <label class="flex items-center">
              <%= check_box_tag "search_in[]", column, (params[:search_in] || DiseaseCases::Searchable::SEARCHABLE_COLUMNS).include?(column), data: { "checkbox-group-target": "checkbox" } %>
              <%= DiseaseCase.human_attribute_name(column) %>
            </label>
          <% end %>
        </div>
      </fieldset>
      <div class="grid-auto">
        <div>
          <%= form.label :result, DiseaseCase.human_attribute_name(:result) %>
          <%= form.select :result, DiseaseCase.enum_options_for_select_with_blank(:result), { selected: params[:result] } %>
        </div>
        <div>
          <%= form.label :year, DiseaseCase.human_attribute_name(:year) %>
          <%= form.select :year, years_for_select_with_blank, { selected: params[:year] } %>
        </div>
      </div>
      <fieldset data-controller="checkbox-group">
        <legend>
          <%= DiseaseCase.human_attribute_name(:disease_category) %>
          <%= link_to t("search.select_all") , "#", data: { action: "click->checkbox-group#selectAll" } %>
          <%= link_to t("search.deselect_all") , "#", data: { action: "click->checkbox-group#deselectAll" } %>
        </legend>
        <div class="checkbox-grid">
          <% DiseaseCase.enum_options_for_select(:disease_category).each do |label, value| %>
            <label class="flex items-center">
              <%= check_box_tag "disease_category[]", value, Array(params[:disease_category]).include?(value), data: { "checkbox-group-target": "checkbox" } %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </fieldset>
      <fieldset data-controller="checkbox-group">
        <legend>
          <%= DiseaseCase.human_attribute_name(:body_part) %>
          <%= link_to t("search.select_all") , "#", data: { action: "click->checkbox-group#selectAll" } %>
          <%= link_to t("search.deselect_all") , "#", data: { action: "click->checkbox-group#deselectAll" } %>
        </legend>
        <div class="checkbox-grid">
          <% DiseaseCase.enum_options_for_select(:body_part).each do |label, value| %>
            <label class="flex items-center">
              <%= check_box_tag "body_part[]", value, Array(params[:body_part]).include?(value), data: { "checkbox-group-target": "checkbox" } %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </fieldset>
      <fieldset data-controller="checkbox-group">
        <legend>
          <%= DiseaseCase.human_attribute_name(:burden_body_part) %>
          <%= link_to t("search.select_all"), "#", data: { action: "click->checkbox-group#selectAll" } %>
          <%= link_to t("search.deselect_all"), "#", data: { action: "click->checkbox-group#deselectAll" } %>
        </legend>
        <div class="checkbox-grid">
          <% @burden_body_part_options.each do |value| %>
            <label class="flex items-center">
              <%= check_box_tag "burden_body_part[]", value, Array(params[:burden_body_part]).include?(value), data: { "checkbox-group-target": "checkbox" } %>
              <%= value %>
            </label>
          <% end %>
        </div>
        <div>
          <%= form.label :burden_body_part_text, t("search.burden_body_part_text_label") %>
          <%= form.text_field :burden_body_part_text, value: params[:burden_body_part_text],
                list: "burden_body_part_datalist", placeholder: t("search.burden_body_part_text_placeholder") %>
          <datalist id="burden_body_part_datalist">
            <% @burden_body_part_datalist_options.each do |value| %>
              <option value="<%= value %>">
            <% end %>
          </datalist>
        </div>
      </fieldset>
      <div class="grid-auto">
        <div>
          <%= form.label :decided_on_from, t("search.filter.decided_on_from") %>
          <%= form.date_field :decided_on_from, value: params[:decided_on_from] %>
        </div>
        <div>
          <%= form.label :decided_on_to, t("search.filter.decided_on_to") %>
          <%= form.date_field :decided_on_to, value: params[:decided_on_to] %>
        </div>
      </div>
      <%= render "structured_filters", form: form %>
    </details>

    <fieldset>
      <legend><%= t("search.sort_label") %></legend>
      <div class="sort-options">
        <label>
          <%= form.radio_button :sort, "relevance", checked: (params[:sort] || "relevance") == "relevance" %>
          <%= t("search.sort_relevance") %>
        </label>
        <label>
          <%= form.radio_button :sort, "recent", checked: params[:sort] == "recent" %>
          <%= t("search.sort_recent") %>
        </label>
      </div>
    </fieldset>
  <% end %>
  <%= render "search_results" %>
</div>
