<% content_for :title, "#{self_care_title} — #{t('layout.site_name')}" %>
<div class="container self-care-form">
  <% if @consent_error %>
    <%= render "error_summary", errors: { "consent" => t("self_care_form.start.consent_error") } %>
  <% end %>
  <% if @session_lost %>
    <p class="notice" role="status"><%= t("self_care_form.start.session_lost") %></p>
  <% end %>

  <h1 tabindex="-1" autofocus><%= self_care_title %></h1>
  <p><%= t("self_care_form.start.lead") %></p>
  <p><%= t("self_care_form.start.about") %></p>

  <%= form_with url: self_care_form_agree_path, method: :post, local: true do %>
    <label for="consent">
      <%= check_box_tag "consent", "1", false, id: "consent",
            "aria-invalid": (@consent_error ? "true" : nil),
            "aria-describedby": (@consent_error ? "consent-error" : nil) %>
      <%= t("self_care_form.start.consent") %>
    </label>
    <% if @consent_error %>
      <small id="consent-error" class="field-error"><%= t("self_care_form.error_prefix") %> <%= t("self_care_form.start.consent_error") %></small>
    <% end %>

    <%# 통계용 저장은 구글 연동이 켜진 배포에서만 선택 동의로 묻는다. 꺼져 있으면 체크란도 안내도 없다. %>
    <% if SelfCareForm.google_enabled? %>
      <label for="stats_consent">
        <%= check_box_tag "stats_consent", "1", false, id: "stats_consent", "aria-describedby": "stats-consent-detail" %>
        <%= t("self_care_form.start.stats_consent") %>
      </label>
      <small id="stats-consent-detail">
        <%= t("self_care_form.start.stats_detail") %>
        <%= t("self_care_form.start.stats_once") %>
        <%= t("self_care_form.start.stats_retention") %>
      </small>
    <% end %>
    <button type="submit"><%= t("self_care_form.start.begin") %></button>
  <% end %>
</div>
