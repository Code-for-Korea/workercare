<%# 입력 오류 요약: 페이지 위에 두고 항목으로 이동하는 링크를 건다. 같은 문구를 항목 옆에도 쓴다. %>
<div class="error-summary" role="alert" tabindex="-1">
  <h2><%= t("self_care_form.error_heading") %></h2>
  <ul>
    <% errors.each do |anchor, message| %>
      <li><a href="#<%= anchor %>"><%= t("self_care_form.error_prefix") %> <%= message %></a></li>
    <% end %>
  </ul>
</div>
