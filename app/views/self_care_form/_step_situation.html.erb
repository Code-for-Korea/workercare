<%= form_with url: self_care_form_step_path("situation"), method: :post, local: true do %>
  <ul class="choices">
    <% SelfCareForm::Flow::SITUATIONS.each do |key, label| %>
      <%= render "choice_button", value: key, label: label, secondary: false %>
    <% end %>
    <%= render "choice_button", value: "skip", label: t("self_care_form.skip"), secondary: true %>
  </ul>
<% end %>
