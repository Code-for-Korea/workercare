<% content_for :title, "#{t('about.title')} — #{t('layout.site_name')}" %>
<div class="container-narrow">
  <h1><%= t("about.title") %></h1>
  <p><%= t("about.lead") %></p>

  <section>
    <h2><%= t("about.features.heading") %></h2>
    <ul>
      <li><%= link_to t("about.features.search"), root_path %> · <%= link_to t("about.features.advanced"), search_path %>: <%= t("about.features.search_text") %></li>
      <li><%= link_to t("about.features.self_care_form"), self_care_form_start_path %>: <%= t("about.features.self_care_form_text") %></li>
      <li><%= link_to t("about.features.apply_guide"), apply_guide_path %>: <%= t("about.features.apply_guide_text") %></li>
      <li><%= t("about.features.markdown") %>: <%= t("about.features.markdown_text") %> <a href="/llms.txt">/llms.txt</a>, <a href="/apply-guide.md">/apply-guide.md</a></li>
    </ul>
  </section>

  <section>
    <h2><%= t("about.reference.heading") %></h2>
    <p><%= t("about.reference.text") %></p>
  </section>

  <section>
    <h2><%= t("about.source.heading") %></h2>
    <p><%= t("about.source.text") %></p>
  </section>

  <section>
    <h2><%= t("about.facts.heading") %></h2>
    <p><%= t("about.facts.basis") %></p>

    <h3><%= t("about.facts.overview_heading") %></h3>
    <div class="table-scroll" role="region" tabindex="0" aria-label="<%= t("about.facts.overview_caption") %>">
      <table>
        <caption><%= t("about.facts.overview_caption") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t("about.facts.col_result") %></th>
            <th scope="col"><%= t("about.facts.col_count") %></th>
            <th scope="col"><%= t("about.facts.col_percent") %></th>
          </tr>
        </thead>
        <tbody>
          <% t("about.facts.results").each do |row| %>
            <tr>
              <th scope="row"><%= row[:label] %></th>
              <td><%= row[:count] %></td>
              <td><%= row[:percent] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p><%= t("about.facts.overview_note") %></p>
    <p><%= t("about.facts.death_text") %></p>
    <p><%= t("about.facts.caveat") %></p>

    <h3><%= t("about.facts.groups_heading") %></h3>
    <p><%= t("about.facts.groups_basis") %></p>
    <% { "disease_groups" => "disease_groups_label", "body_parts" => "body_parts_label" }.each do |rows_key, label_key| %>
      <div class="table-scroll" role="region" tabindex="0" aria-label="<%= t("about.facts.#{label_key}") %>">
        <table>
          <caption><%= t("about.facts.#{label_key}") %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t("about.facts.#{label_key}") %></th>
              <th scope="col"><%= t("about.facts.col_count") %></th>
              <th scope="col"><%= t("about.facts.col_percent") %></th>
            </tr>
          </thead>
          <tbody>
            <% t("about.facts.#{rows_key}").each do |row| %>
              <tr>
                <th scope="row"><%= row[:label] %></th>
                <td><%= row[:count] %></td>
                <td><%= row[:percent] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <h3><%= t("about.facts.checks_heading") %></h3>
    <p><%= t("about.facts.checks_lead") %></p>
    <ul>
      <% t("about.facts.checks").each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>

    <h3><%= t("about.facts.limits_heading") %></h3>
    <p><%= t("about.facts.limits_text") %></p>
  </section>

  <section>
    <h2><%= t("about.privacy.heading") %></h2>
    <p><%= t("about.privacy.lead") %></p>
    <h3><%= t("about.privacy.self_care_heading") %></h3>
    <p><%= t("about.privacy.self_care_text") %></p>
    <h3><%= t("about.privacy.display_heading") %></h3>
    <p><%= t("about.privacy.display_text") %></p>
    <h3><%= t("about.privacy.summary_heading") %></h3>
    <p><%= t("about.privacy.summary_text") %></p>
    <h3><%= t("about.privacy.stats_heading") %></h3>
    <p><%= t(SelfCareForm::Settings.current.enabled? ? "about.privacy.stats_text_on" : "about.privacy.stats_text_off") %></p>
  </section>
</div>
